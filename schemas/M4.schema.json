{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orllm:M4:1.0",
  "title": "M4 固定模型参数输入",
  "type": "object",
  "properties": {
    "model_id": {
      "const": "M4"
    },
    "model_version": {
      "const": "1.0"
    },
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "C": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "q": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "depot_id": {
      "type": "string",
      "minLength": 1
    },
    "U": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "Q": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "h": {
      "type": "number",
      "minimum": 0
    },
    "ell": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "B": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "p": {
      "type": "number",
      "minimum": 0
    },
    "r0": {
      "type": "number",
      "minimum": 0
    },
    "r1": {
      "type": "number",
      "minimum": 0
    },
    "distance_unit": {
      "const": "km"
    }
  },
  "required": [
    "model_id",
    "model_version",
    "instance_id",
    "C",
    "q",
    "depot_id",
    "U",
    "Q",
    "h",
    "ell",
    "B",
    "p",
    "r0",
    "r1",
    "distance_unit"
  ],
  "additionalProperties": false
}
