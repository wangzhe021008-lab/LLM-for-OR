{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orllm:M2:1.0",
  "title": "M2 固定模型参数输入",
  "type": "object",
  "properties": {
    "model_id": {
      "const": "M2"
    },
    "model_version": {
      "const": "1.0"
    },
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "C": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "q": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "D": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "U": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "g": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "required": [
    "model_id",
    "model_version",
    "instance_id",
    "C",
    "q",
    "D",
    "U",
    "g"
  ],
  "additionalProperties": false
}
